# Copy to .env and replace every change-me value (never commit .env):
#   cp .env.example .env
# Generate a secret with: openssl rand -hex 16

# --- Compose: lets plain `docker compose ...` work from the repo root ---
COMPOSE_FILE=infrastructure/docker-compose.yml

# --- Image tags (pinned; see CLAUDE.md section 5) ---
POSTGRES_TAG=17.11
RUSTFS_TAG=1.0.1
AWSCLI_TAG=2.37.13

# --- Postgres superuser (admin only; services get their own roles) ---
POSTGRES_USER=lakehouse_admin
POSTGRES_PASSWORD=change-me

# --- Per-service database roles (created on first start by postgres/init/) ---
AIRFLOW_DB_PASSWORD=change-me
LAKEKEEPER_DB_PASSWORD=change-me

# --- RustFS / S3 credentials (used by RustFS, the bucket init, and later Trino/PyIceberg) ---
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me
