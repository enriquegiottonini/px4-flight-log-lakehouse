# Copy to .env and replace every change-me value (never commit .env):
#   cp .env.example .env
# Generate a secret with: openssl rand -hex 16

# --- Compose: lets plain `docker compose ...` work from the repo root ---
COMPOSE_FILE=infrastructure/docker-compose.yml

# --- Image tags (pinned; see CLAUDE.md section 5) ---
POSTGRES_TAG=17.11
RUSTFS_TAG=1.0.1
AWSCLI_TAG=2.37.13
LAKEKEEPER_TAG=v0.14.0
TRINO_TAG=483
CURL_TAG=8.22.0

# --- Postgres superuser (admin only; services get their own roles) ---
POSTGRES_USER=lakehouse_admin
POSTGRES_PASSWORD=change-me

# --- Per-service database roles (created on first start by postgres/init/) ---
AIRFLOW_DB_PASSWORD=change-me
LAKEKEEPER_DB_PASSWORD=change-me

# --- RustFS / S3 credentials (used by RustFS, the bucket init, and later Trino/PyIceberg) ---
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me

# --- Lakekeeper: encrypts secrets it stores in Postgres (e.g. the warehouse's S3 keys) ---
# Changing it later makes stored secrets unreadable: keep it stable, or `make reset`.
LAKEKEEPER_ENCRYPTION_KEY=change-me

# --- Airflow (Phase 5) ---
AIRFLOW_TAG=3.3.2-python3.12
AIRFLOW_FERNET_KEY=change-me-fernet       # encrypts connections/variables in the metadata db
AIRFLOW_JWT_SECRET=change-me              # signs the tokens task processes use for the execution API
AIRFLOW_API_SECRET_KEY=change-me

# --- PX4 ingestion knobs (read by drone_ingest inside Airflow) ---
PX4_INDEX_START_DATE=2025-01-01
# Empty = every ULog of the day (~9 GB, D-004). Set a number to cap downloads on a small disk.
PX4_MAX_ULOGS_PER_RUN=
